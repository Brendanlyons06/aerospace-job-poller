# careers/watch.py — job alert notifications

# Search profile.  Use `aerospace` for the aerospace/mechanical/system-
# engineering internship watchlist, or leave as `swe_ml` for the original
# software/ML behavior.
JOB_POLLER_PROFILE=aerospace

# Optional comma-separated module names or company names for a small pilot.
# Example: JOB_POLLER_COMPANIES=spacex,blueorigin,Northrop Grumman
JOB_POLLER_COMPANIES=

# Optional comma-separated folders to skip in the selected profile.
JOB_POLLER_DISABLED_COMPANIES=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
SMS_ALERTS_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ALERTS_ENABLED=true
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated recipient addresses are supported.
EMAIL_TO=
